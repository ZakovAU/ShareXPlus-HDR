<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.20348.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>ShareX_Icon.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Screen capture, file sharing and productivity tool</Description>
    <NoWarn>WFO1000</NoWarn>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <!-- Ahead-of-time crossgen the bundled assemblies: faster startup and steady-state
         for the capture hot paths, at the cost of a somewhat larger single file. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Embed symbols in the single file instead of shipping a separate PDB; stack
         traces in error reports keep working and there is one less file to deploy. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="1.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters.CoreServices" Version="1.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ShareX.HistoryLib\ShareX.HistoryLib.csproj" />
    <ProjectReference Include="..\ShareX.ImageEffectsLib\ShareX.ImageEffectsLib.csproj" />
    <ProjectReference Include="..\ShareX.IndexerLib\ShareX.IndexerLib.csproj" />
    <ProjectReference Include="..\ShareX.MediaLib\ShareX.MediaLib.csproj" />
    <ProjectReference Include="..\ShareX.ScreenCaptureLib\ShareX.ScreenCaptureLib.csproj" />
    <ProjectReference Include="..\ShareX.HelpersLib\ShareX.HelpersLib.csproj" />
    <ProjectReference Include="..\ShareX.UploadersLib\ShareX.UploadersLib.csproj" />
    <!-- Ordering-only reference: makes sure ShareX.Setup.exe exists before the
         CompileInstaller post-build target runs, without referencing its assembly. -->
    <ProjectReference Include="..\ShareX.Setup\ShareX.Setup.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <None Update="host-manifest-chrome.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="host-manifest-firefox.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="ShareX_File_Icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Post-build: bump the patch number in version.txt so the next Release build gets a
       new version. The increment is written after this build, so the binaries and the
       installer compiled below always carry the version this build actually used.
       Skip with /p:BumpVersion=false. -->
  <Target Name="BumpVersion" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(BumpVersion)' != 'false'">
    <PropertyGroup>
      <VersionFile>$(MSBuildProjectDirectory)\..\version.txt</VersionFile>
      <CurrentPatch>$([System.IO.File]::ReadAllText('$(VersionFile)').Trim())</CurrentPatch>
      <NextPatch>$([MSBuild]::Add($(CurrentPatch), 1))</NextPatch>
    </PropertyGroup>
    <WriteLinesToFile File="$(VersionFile)" Lines="$(NextPatch)" Overwrite="true" />
    <Message Importance="high" Text="Version for this build: $(Version). Next Release build will be patch $(NextPatch)." />
  </Target>

  <!-- Post-build: compile the Inno Setup installer into Output\.
       Runs ShareX.Setup with an installer-only job, which keeps the already downloaded
       tools and just recompiles the .iss files against the freshly built binaries.
       Skip with /p:CompileInstaller=false. Requires ShareX.Setup to be built first
       (it is, when building the solution). -->
  <Target Name="CompileInstaller" AfterTargets="BumpVersion"
          Condition="'$(Configuration)' == 'Release' and '$(CompileInstaller)' != 'false'">
    <PropertyGroup>
      <ShareXSetupExe>$(MSBuildProjectDirectory)\..\ShareX.Setup\bin\$(Configuration)\win-x64\ShareX.Setup.exe</ShareXSetupExe>
    </PropertyGroup>
    <Warning Condition="!Exists('$(ShareXSetupExe)')"
             Text="ShareX.Setup.exe was not found at '$(ShareXSetupExe)'. Build the ShareX.Setup project first; skipping installer compilation." />
    <Exec Condition="Exists('$(ShareXSetupExe)')"
          WorkingDirectory="$(MSBuildProjectDirectory)\.."
          Command="&quot;$(ShareXSetupExe)&quot; -Silent -Job CreateSetup,DownloadTools"
          IgnoreExitCode="false" />
  </Target>
</Project>